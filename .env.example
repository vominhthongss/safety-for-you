# Optional delay for the friendly in-app splash; 0 = show home immediately.
EXPO_PUBLIC_SPLASH_MIN_MS=180
# Foreground refresh interval in seconds; minimum 60.
EXPO_PUBLIC_REFRESH_SECONDS=120
# Deploy server/worker.js to Cloudflare and enter its public URL; otherwise JMA categories show "Not configured".
EXPO_PUBLIC_JMA_PROXY_URL=
# App identifiers for your own store accounts.
ANDROID_PACKAGE=com.vominhthongss.safetyforyou
IOS_BUNDLE_ID=com.vominhthongss.safetyforyou
# UUID from your Expo project; leave empty for Expo Go.
EAS_PROJECT_ID=

# Optional self-hosted Kanji -> Romaji converter (see romaji-service/README.md)
EXPO_PUBLIC_ROMAJI_API_URL=
